n    \\\\\"deal_outcome\\\\\": \\\\\"Won\\\\\",\\\\n    \\\\\"sales_channel\\\\\": \\\\\"Branch\\\\\",\\\\n    \\\\\"policy_min_margin_pct\\\\\": 2.2,\\\\n    \\\\\"policy_min_expected_margin_pct\\\\\": 0.75,\\\\n    \\\\\"policy_max_discount_pct\\\\\": 0.45,\\\\n    \\\\\"policy_rwa_risk_weight_pct\\\\\": 75,\\\\n    \\\\\"price_below_policy_floor\\\\\": 0,\\\\n    \\\\\"margin_below_min\\\\\": 0,\\\\n    \\\\\"discount_exceeds_policy\\\\\": 0,\\\\n    \\\\\"policy_compliant\\\\\": 1\\\\n  },\\\\n  {\\\\n    \\\\\"deal_id\\\\\": \\\\\"DEAL038\\\\\",\\\\n    \\\\\"deal_date\\\\\": \\\\\"2025-06-04\\\\\",\\\\n    \\\\\"customer_id\\\\\": \\\\\"CUST003\\\\\",\\\\n    \\\\\"customer_name\\\\\": \\\\\"Gulf Star Logistics\\\\\",\\\\n    \\\\\"customer_segment\\\\\": \\\\\"Corporate\\\\\",\\\\n    \\\\\"risk_category\\\\\": \\\\\"Medium\\\\\",\\\\n    \\\\\"internal_rating\\\\\": \\\\\"BBB+\\\\\",\\\\n    \\\\\"product_id\\\\\": \\\\\"PROD002\\\\\",\\\\n    \\\\\"product_name\\\\\": \\\\\"Term Loan\\\\\",\\\\n    \\\\\"product_type\\\\\": \\\\\"Loan\\\\\",\\\\n    \\\\\"pricing_method\\\\\": \\\\\"Floating\\\\\",\\\\n    \\\\\"max_discount_allowed_pct\\\\\": 0.6,\\\\n    \\\\\"currency\\\\\": \\\\\"AED\\\\\",\\\\n    \\\\\"tenor\\\\\": \\\\\"24M\\\\\",\\\\n    \\\\\"requested_amount\\\\\": 14000000,\\\\n    \\\\\"funding_cost_pct\\\\\": 5.7,\\\\n    \\\\\"standard_margin_pct\\\\\": 2.1,\\\\n    \\\\\"risk_premium_pct\\\\\": 0.45,\\\\n    \\\\\"relationship_discount_pct\\\\\": 0.3,\\\\n    \\\\\"recommended_price_pct\\\\\": 7.95,\\\\n    \\\\\"final_approved_price_pct\\\\\": 7.95,\\\\n    \\\\\"expected_margin_pct\\\\\": 1.9,\\\\n    \\\\\"deal_outcome\\\\\": \\\\\"Won\\\\\",\\\\n    \\\\\"sales_channel\\\\\": \\\\\"API Quote\\\\\",\\\\n    \\\\\"policy_min_margin_pct\\\\\": 2.2,\\\\n    \\\\\"policy_min_expected_margin_pct\\\\\": 0.75,\\\\n    \\\\\"policy_max_discount_pct\\\\\": 0.45,\\\\n    \\\\\"policy_rwa_risk_weight_pct\\\\\": 75,\\\\n    \\\\\"price_below_policy_fl