currency\\\\\": \\\\\"AED\\\\\",\\\\n    \\\\\"tenor\\\\\": \\\\\"3M\\\\\",\\\\n    \\\\\"requested_amount\\\\\": 7600000,\\\\n    \\\\\"funding_cost_pct\\\\\": 5.25,\\\\n    \\\\\"standard_margin_pct\\\\\": 1.25,\\\\n    \\\\\"risk_premium_pct\\\\\": 0.45,\\\\n    \\\\\"relationship_discount_pct\\\\\": 0.25,\\\\n    \\\\\"recommended_price_pct\\\\\": 6.7,\\\\n    \\\\\"final_approved_price_pct\\\\\": 6.5,\\\\n    \\\\\"expected_margin_pct\\\\\": 0.9,\\\\n    \\\\\"deal_outcome\\\\\": \\\\\"Won\\\\\",\\\\n    \\\\\"sales_channel\\\\\": \\\\\"Branch\\\\\",\\\\n    \\\\\"policy_min_margin_pct\\\\\": 1.75,\\\\n    \\\\\"policy_min_expected_margin_pct\\\\\": 0.75,\\\\n    \\\\\"policy_max_discount_pct\\\\\": 0.25,\\\\n    \\\\\"policy_rwa_risk_weight_pct\\\\\": 75,\\\\n    \\\\\"price_below_policy_floor\\\\\": 0,\\\\n    \\\\\"margin_below_min\\\\\": 0,\\\\n    \\\\\"discount_exceeds_policy\\\\\": 0,\\\\n    \\\\\"policy_compliant\\\\\": 1\\\\n  }\\\\n]\"}'}]}"}
