n:\n\nTraceback (most recent call last):\n  File \"C:\\Users\\manoj.chevula\\Desktop\\antigravity\\agent-mesh-15062026\\fab-venv\\Lib\\site-packages\\agent_framework_a2a\\_a2a_executor.py\", line 168, in execute\n    await self._run(query, session, updater)\n  File \"C:\\Users\\manoj.chevula\\Desktop\\antigravity\\agent-mesh-15062026\\fab-venv\\Lib\\site-packages\\agent_framework_a2a\\_a2a_executor.py\", line 202, in _run\n    response = await self._agent.run(query, session=session, stream=False, **self._run_kwargs)\n               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"C:\\Users\\manoj.chevula\\Desktop\\antigravity\\agent-mesh-15062026\\fab-venv\\Lib\\site-packages\\agent_framework\\_middleware.py\", line 1401, in _execute\n    return await pipeline.execute(\n           ^^^^^^^^^^^^^^^^^^^^^^^\n    ...<2 lines>...\n    )\n    ^\n  File \"C:\\Users\\manoj.chevula\\Desktop\\antigravity\\agent-mesh-15062026\\fab-venv\\Lib\\site-packages\\agent_framework\\_middleware.py\", line 922, in execute\n    await first_handler()\n  File \"C:\\Users\\manoj.chevula\\Desktop\\antigravity\\agent-mesh-15062026\\fab-venv\\Lib\\site-packages\\agent_framework\\_middleware.py\", line 916, in current_handler\n    await self._middleware[index].process(context, create_next_handler(index + 1))\n  File \"C:\\Users\\manoj.chevula\\Desktop\\antigravity\\agent-mesh-15062026\\agent-mesh\\src\\middleware\\audit_middleware.py\", line 132, in process\n    raise e\n  File \"C:\\Users\\manoj.chevula\\Desktop\\antigravity\\agent-mesh-15062026\\agent-mesh\\src\\middleware\\audit_middleware.py\", line 128, in process\n    await call_next()\n  File \"C:\\Users\\manoj.chevula\\Desktop\\antigravity\\agent-mesh-15062026\\fab-venv\\Lib\\site-packages\\agent_framework\\_middleware.py\", line 908, in final_wrapper\n    context.result = await cast(Awaitable[AgentResponse], result)\n                     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"C:\\Users\\manoj.chevula\\Desktop\\antigravity\\agent-mesh-15062026\\fab-venv\\Lib\\site-packages\\agent_framework\\observability.py\", line 1884, in _run\n    response: AgentResponse[Any] = await execute()\n                                   ^^^^^^^^^^^^^^^\n  File \"C:\\Users\\manoj.chevula\\Desktop\\antigravity\\agent-mesh-15062026\\fab-venv\\Lib\\site-packages\\agent_framework\\_agents.py\", line 964, in _run_non_streaming\n    response = await self._call_chat_client(ctx, stream=False)\n               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"C:\\Users\\manoj.chevula\\Desktop\\antigravity\\agent-mesh-15062026\\fab-venv\\Lib\\site-packages\\agent_framework\\_tools.py\", line 2600, in _get_response\n    await super_get_response(\n    ^^^^^^^^^^^^^^^^^^^^^^^^^\n    ...<6 lines>...\n    ),\n    ^\n  File \"C:\\Users\\manoj.chevula\\Desktop\\antigravity\\agent-mesh-15062026\\fab-venv\\Lib\\site-packages\\agent_framework\\observability.py\", line 1614, in _get_response\n    await super_get_response(\n    ^^^^^^^^^^^^^^^^^^^^^^^^^\n    ...<7 lines>...\n    ),\n    ^\n  File \"C:\\Users\\manoj.chevula\\Desktop\\antigravity\\agent-mesh-15062026\\fab-venv\\Lib\\site-packages\\agent_framework_openai\\_chat_completion_client.py\", line 571, in _get_response\n    raise ChatClientException(\n    ...<5 lines>...\n    ) from ex\nagent_framework.exceptions.ChatClientException: (\"<class 'agent_framework_openai._chat_completion_client.OpenAIChatCompletionClient'> service failed to complete the prompt: Error code: 413 - {'error': {'message': 'Request too large for model `openai/gpt-oss-120b` in organization `org_01jf7zcn7petgsq9sd18zszhtz` service tier `on_demand` on tokens per minute (TPM): Limit 8000, Requested 17744, please reduce your message size and try again. Need more tokens? Upgrade to Dev Tier today at https://console.groq.com/settings/billing', 'type': 'tokens', 'code': 'rate_limit_exceeded'}}\", APIStatusError(\"Error code: 413 - {'error': {'message': 'Requ