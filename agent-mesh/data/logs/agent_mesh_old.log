tool_call>\\\\n<function=search_documents>\\\\n<parameter=query>\\\\nFAB Credit Pricing Policy relationship value adjustment reduction up to 25 basis points cross-sell revenue threshold AED 500,000\\\\n</parameter>\\\\n<parameter=generate_answer>\\\\nTrue\\\\n</parameter>\\\\n<parameter=top_k>\\\\n5\\\\n</parameter>\\\\n</function>\\\\n</tool_call>'}}\", BadRequestError(\"Error code: 400 - {'error': {'message': 'tool call validation failed: parameters for tool search_documents did not match schema: errors: [`/generate_answer`: expected boolean, but got string]', 'type': 'invalid_request_error', 'code': 'tool_use_failed', 'failed_generation': '<tool_call>\\\\n<function=search_documents>\\\\n<parameter=query>\\\\nFAB Credit Pricing Policy relationship value adjustment reduction up to 25 basis points cross-sell revenue threshold AED 500,000\\\\n</parameter>\\\\n<parameter=generate_answer>\\\\nTrue\\\\n</parameter>\\\\n<parameter=top_k>\\\\n5\\\\n</parameter>\\\\n</function>\\\\n</tool_call>'}}\"))"}
