{"ts": "2026-07-03T13:47:27+0530", "level": "INFO", "logger": "agent_framework", "trace_id": "76716a21c678ab2a5a0f3c0a75a766aa", "span_id": "4fb6e43650202436", "parent_span_id": "-", "request_id": "9739E7AC", "msg": "{'role': 'assistant', 'parts': [{'type': 'tool_call', 'id': 'fc_7bb8750a-3ddd-42e9-bdca-716531567856', 'name': 'query_structured_data', 'arguments': '{\"question\":\"What is the recommended price for CUST001?\"}'}]}"}
