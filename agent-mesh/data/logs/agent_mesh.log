debt_to_equity_ratio\\\\\": 0.48,\\\\n    \\\\\"credit_score\\\\\": 720,\\\\n    \\\\\"existing_exposure_aed\\\\\": 16000000,\\\\n    \\\\\"total_deals\\\\\": 4,\\\\n    \\\\\"won_deals\\\\\": 4.0,\\\\n    \\\\\"lost_deals\\\\\": 0.0,\\\\n    \\\\\"total_deal_volume_aed\\\\\": 63500000.0,\\\\n    \\\\\"avg_deal_size_aed\\\\\": 15875000.0,\\\\n    \\\\\"avg_expected_margin_pct\\\\\": 1.65,\\\\n    \\\\\"avg_approved_price_pct\\\\\": 7.737499999999999,\\\\n    \\\\\"avg_relationship_discount_pct\\\\\": 0.3,\\\\n    \\\\\"last_deal_date\\\\\": \\\\\"2025-12-22 00:00:00\\\\\",\\\\n    \\\\\"win_rate_pct\\\\\": 100.0\\\\n  }\\\\n]\"}'}]}"}
