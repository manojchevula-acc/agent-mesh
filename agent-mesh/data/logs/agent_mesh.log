\\\\"funding_cost_pct\\\\\": 5.55,\\\\n    \\\\\"risk_premium_pct\\\\\": 0.1,\\\\n    \\\\\"relationship_discount_pct\\\\\": 0.45,\\\\n    \\\\\"recommended_price_pct\\\\\": 7.3,\\\\n    \\\\\"final_approved_price_pct\\\\\": 7.25,\\\\n    \\\\\"expected_margin_pct\\\\\": 1.35,\\\\n    \\\\\"deal_outcome\\\\\": \\\\\"Won\\\\\",\\\\n    \\\\\"benchmark_rate_pct_treasury\\\\\": 5.35,\\\\n    \\\\\"funding_cost_pct_treasury\\\\\": 5.55,\\\\n    \\\\\"net_margin_pct\\\\\": 1.15,\\\\n    \\\\\"spread_over_benchmark_pct\\\\\": 1.9,\\\\n    \\\\\"margin_vs_recommended_pct\\\\\": -0.05\\\\n  }\\\\n]\"}'}]}"}
