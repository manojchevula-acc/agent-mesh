# ==============================================================================
# Microsoft Agent Framework Demo Configuration
# ==============================================================================

# Ollama LLM Configuration (Local Ollama LLM)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
RAG_LLM_GROQ_API_KEY = ""
GROQ_API_KEY = ""
GROQ_MODEL=openai/gpt-oss-20b

# Per-agent model assignments (task-optimised)
# Compliance: fast production model — safety classification, no tool calls
COMPLIANCE_MODEL=openai/gpt-oss-20b
# Data Agent: parallel tool use — calls 5 SQL-backed MCP tools
DATA_AGENT_MODEL=qwen/qwen3.6-27b
# RAG Agent: parallel tool use — calls search_documents MCP tool
RAG_AGENT_MODEL=qwen/qwen3.6-27b
# Price Assist: orchestrator — intent classification, A2A delegation, synthesis
PRICE_ASSIST_MODEL=openai/gpt-oss-120b

# Per-agent Groq API keys — split across two keys to avoid rate limits
# Key 1: Compliance + Data Agent
COMPLIANCE_API_KEY=
DATA_AGENT_API_KEY=
# Key 2: RAG Agent + Price Assist
RAG_AGENT_API_KEY=
PRICE_ASSIST_API_KEY=

# RAG cross-encoder reranker (BAAI/bge-reranker-v2-m3, ~2 GB).
# Set to false until the model has been fully downloaded — otherwise the first
# pricing query will time out waiting for the download to complete.
# Switch back to true once the download finishes for best retrieval quality.
RAG_RERANKER_ENABLED=true

# A2A call timeout in seconds (default 180). Price Assist loads BGE-M3 (~30s) +
# reranker (~30s) on first call, then runs Ollama twice. 600s gives 10 minutes
# of headroom for cold-start + slow CPU inference.
A2A_TIMEOUT=600

HF_HUB_DISABLE_SYMLINKS_WARNING=1
# Storage Configuration
POLICIES_FILE=data/policies.json
AUDIT_LOG_FILE=data/audit_trail.jsonl
CONVERSATION_STORE_DIR=data/conversations

# External services consumed by domain agents over MCP (streamable HTTP).
DATALAYER_MCP_URL=http://127.0.0.1:9100/mcp
RAG_MCP_URL=http://127.0.0.1:9000/mcp
RAG_API_KEY=
MCP_REQUEST_TIMEOUT=600

# ==============================================================================
# Observability — telemetry goes ONLY through the Gernas SDK (GERNAS_* block below):
# SDK -> OTel Collector -> Azure Data Explorer (data plane) + Opik (trace view).
# ==============================================================================
# Agent Framework's own instrumentation is switched off by the integration
# (gernas_telemetry.init_telemetry); keep these false so it never captures payloads.
ENABLE_INSTRUMENTATION=false
ENABLE_SENSITIVE_DATA=false
# a2a-sdk built-in tracing off: the Gernas SDK instruments A2A hops.
OTEL_INSTRUMENTATION_A2A_SDK_ENABLED=false

# Centralized application logging (durable, rotating, trace-correlated).
LOG_LEVEL=INFO
LOG_FILE=data/logs/agent_mesh.log
LOG_JSON=false
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ==============================================================================
# DevUI (Docker-free live trace + agent visualization)
# ==============================================================================
# `python devui_app.py` runs the whole mesh in ONE process so DevUI captures the
# full in-process trace tree (workflow -> executors -> agents -> tools). DevUI is
# a development-only tool — do not expose it as a production surface.
DEVUI_HOST=127.0.0.1
DEVUI_PORT=8090
# Identity stamped on DevUI requests (used for audit logging on each hop).
DEVUI_USER=alice
DEVUI_ROLE=platform_administrator
DEVUI_AUTO_OPEN=true
# No-auth is honoured by DevUI on loopback hosts only.
DEVUI_NO_AUTH=true

# ─────────────────────────────────────────────────────────────────────────────
# Gernas SDK (gernas-telemetry) — the mesh's telemetry. Environment-only config.
# Telemetry always goes SDK → OTel Collector → Opik / data plane (never direct).
# Start the Collector first:  powershell ../gernas-sdk/scripts/run_collector.ps1
# If mandatory GERNAS_* identity is missing, telemetry is disabled with one warning.
# ─────────────────────────────────────────────────────────────────────────────
GERNAS_OTLP_ENDPOINT=http://127.0.0.1:4317
GERNAS_OTLP_TRANSPORT=grpc
# GERNAS_EXPORTER=otlp            # otlp | console | off
# Mandatory identity (GERNAS_SERVICE_NAME is passed by each mesh entrypoint)
GERNAS_USE_CASE_ID=UC-FAB-PRICING-001
GERNAS_APPLICATION_ID=agent-mesh
GERNAS_BUSINESS_DOMAIN=fab_pricing
GERNAS_ENVIRONMENT=dev
GERNAS_SERVICE_VERSION=15.0.6
GERNAS_LOG_NAMESPACES=gernas,mesh,src
# HMAC key for tokenized_user_id; unset = user identity is not recorded at all
GERNAS_USER_TOKEN_KEY=
# Agent runtime KPIs
GERNAS_LOOP_THRESHOLD=3
GERNAS_MAX_STEPS=25
# Cost: rate card JSON (model/provider -> AED per 1K tokens). Unset = no cost attribute.
GERNAS_RATE_CARD_PATH=../gernas-sdk/examples/rate_card.example.json
# Model provider label of LLM_BASE_URL on llm.call spans (mesh setting)
LLM_PROVIDER=groq

# OTel Collector destinations (read by the Collector, not by the mesh — see
# gernas-sdk/docs/collector-aks-deployment.md). Without ADX_CLUSTER_URI the local
# Collector writes the data plane to gernas-sdk/collector/out/ instead of ADX.
# ADX_CLUSTER_URI=https://<adx-cluster>.<region>.kusto.windows.net
# ADX_DATABASE=gernas_telemetry
# Local (non-AKS) ADX auth via the Azure default credential chain, e.g. a service principal:
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# OPIK_API_KEY=
# OPIK_WORKSPACE=
# OPIK_PROJECT_NAME=
