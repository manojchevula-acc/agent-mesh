# ── SQL Agent — backend configuration ────────────────────────────────────────
# Copy to `.env` and fill in. Loaded by sql_agent/config.py (pydantic-settings).

# --- Database (SELECT-only credential) ---------------------------------------
# Use a read-only DB user. Dialect is inferred from the DSN scheme when blank.
DB_DSN=mysql+pymysql://user:password@localhost:3306/fab_data
# Active SQL dialect: postgres | mysql. Blank = infer from the DSN scheme.
DB_DIALECT=

# --- Default LLM -------------------------------------------------------------
# provider: groq | openai | azure | anthropic
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0

# --- Per-step LLM overrides (blank = fall back to the default above) ----------
# step: agent (ReAct tool selection) | generation (tier-3 SQL) |
#       correction (self-correction retry) | judge (LLM-as-judge)
LLM_AGENT_PROVIDER=
LLM_AGENT_MODEL=
LLM_GENERATION_PROVIDER=
LLM_GENERATION_MODEL=
LLM_CORRECTION_PROVIDER=
LLM_CORRECTION_MODEL=
LLM_JUDGE_PROVIDER=
LLM_JUDGE_MODEL=

# --- Provider credentials ----------------------------------------------------
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-06-01

# --- Safety / execution constants --------------------------------------------
ROW_CAP=50
STATEMENT_TIMEOUT_SECONDS=10
MAX_TOOL_CALLS_PER_TURN=10
MAX_DYNAMIC_CALLS_PER_TURN=2
MAX_SELF_CORRECTION_ATTEMPTS=3
CACHE_TTL_SECONDS=60

# --- Agent metadata DB (conversation history + feedback + examples) ----------
# Stores conversation memory, sessions, turns, feedback, and examples.
# SEPARATE from DB_DSN (the governed read-only business DB).
#
# Three options — pick ONE and set CHECKPOINTER_BACKEND to match:
#
# OPTION 1 — SQLite (recommended to start; a single file, no server needed)
# AGENT_DB_DSN=sqlite:///./agent_meta.db
# CHECKPOINTER_BACKEND=sqlite
#
# OPTION 2 — PostgreSQL (production; multi-worker safe; durable)
# AGENT_DB_DSN=postgresql://agent:secret@localhost:5432/sql_agent_meta
# CHECKPOINTER_BACKEND=postgres
#
# OPTION 3 — In-memory (default; no infra; history lost on restart)
# AGENT_DB_DSN=          (leave blank)
# CHECKPOINTER_BACKEND=memory
#
# Uncomment the option you want:
AGENT_DB_DSN=
CHECKPOINTER_BACKEND=memory

# Max Postgres connections in the checkpointer pool (postgres backend only).
AGENT_DB_POOL_MAX=10
# How many recent messages to send to the model (bounds cost as chat grows).
SHORT_TERM_MAX_MESSAGES=20

# --- Feedback / examples -----------------------------------------------------
FEEDBACK_ENABLED=true
EXAMPLES_ENABLED=true
MAX_FEWSHOT_EXAMPLES=5

# --- Production upgrade: scoped schema retrieval (Component B) ----------------
# Optional deps:  uv sync --extra retrieval
SCHEMA_RETRIEVAL_ENABLED=false
EMBEDDING_BACKEND=local                       # local | azure | none
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_QUERY_PREFIX=Represent this sentence for retrieving relevant tables:
EMBEDDING_TOP_K=8
RRF_K=60
SCHEMA_LINK_ENABLED=true
# Vector index — WHERE vectors live/are searched.
VECTOR_BACKEND=memory                         # memory | faiss | qdrant
VECTOR_INDEX_PATH=                            # faiss only: file to persist/load
# Qdrant (no Docker needed): set QDRANT_PATH for local on-disk mode, OR QDRANT_URL for a
# running server. Precedence: url -> path -> in-memory.
QDRANT_URL=                                   # server mode, e.g. http://localhost:6333
QDRANT_PATH=                                  # local on-disk mode, e.g. ./qdrant_data
QDRANT_API_KEY=
QDRANT_COLLECTION=sql_agent_schema

# --- Production upgrade: intent detection + answer judge (Components A & C) ---
INTENT_DETECTION_ENABLED=false
INTENT_DETECTION_ENFORCED=false
LLM_INTENT_PROVIDER=                           # intent classifier; blank = default LLM
LLM_INTENT_MODEL=
LLM_PLAN_PROVIDER=                             # schema-link planner; blank = default LLM
LLM_PLAN_MODEL=
ANSWER_VALIDATION_ENABLED=false
ANSWER_VALIDATION_ENFORCED=false
ANSWER_VALIDATION_MIN_CONFIDENCE=0.7
JOIN_GRAPH_CHECK_ENABLED=true
EXECUTION_GUARD_ENABLED=false
EXECUTION_COST_MAX=1000000

# ── Tool-tier toggles ─────────────────────────────────────────────────────────
# Turn the fixed tiers off to force the agent onto the dynamic SQL tier. When BOTH are
# false the dynamic tool is bound and its dynamic_sql scope gate is bypassed automatically,
# so it becomes the sole data path. Defaults (true) keep the current tiered behaviour.
PARAMETERISED_TOOLS_ENABLED=true
SEMI_DYNAMIC_TOOLS_ENABLED=true
# Best-effort customer NAME -> customer_id resolution for the dynamic tier (mirrors the
# view tools) so a question naming a customer by name is filtered on the id.
DYNAMIC_ENTITY_RESOLUTION_ENABLED=true

# ── Production upgrade: metadata Knowledge Graph ──────────────────────────────
# Schema-level graph (Table / Column / Term nodes) built from information_schema +
# schema.yaml + the business glossary. Metadata only — no row data. Shadow-first: with
# KG_ENABLED=false nothing in the request path changes.
# Build it first:  uv run python scripts/build_metadata_kg.py
# Check for drift: uv run python scripts/build_metadata_kg.py --check   (CI / migration hook)
KG_ENABLED=false
# memory => the built JSON artifact in RAM, BFS in Python. No server, no driver.
# neo4j  => a real graph DB (uv sync --extra kg). Only needed at much larger schema scale.
KG_BACKEND=memory
KG_ARTIFACT_PATH=./kg/metadata_kg.json
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Which retrieval signals run. auto = all of them, unioned (the measured design).
# template | semantic | exact isolate one signal — for evaluation, not production.
KG_RETRIEVAL_STRATEGY=auto
# :Term + :Scenario vectors reuse EMBEDDING_* and VECTOR_BACKEND above; only the collection
# is new (~44 vectors). There is deliberately NO column-vector collection (measured +0
# recall on top of the existing table-level retrieval).
KG_NODE_COLLECTION=sql_agent_kg_nodes
KG_TERM_TOP_K=5
KG_TERM_MIN_SCORE=0.50
KG_SCENARIO_TOP_K=8
# How many fused candidates reach the schema planner. 0 = uncapped (pass everything).
# 100% gold-table recall first arrives at 8; 12 leaves headroom while still being tighter
# than a plain union of all signals (17.6). Tighten only after re-validating the weights.
KG_CANDIDATE_TOP_K=12
# Fusion weights — TUNED ON THE EVAL GOLD SETS. Re-validate on held-out questions before
# trusting them forward. Leave at the defaults unless you are running that experiment.
KG_WEIGHT_LEXICAL=1.6
KG_WEIGHT_COVERAGE=1.0
KG_WEIGHT_EXACT=0.5
KG_WEIGHT_TERM=0.5
KG_WEIGHT_TEMPLATE=0.5
KG_WEIGHT_RANK=12.0
KG_RANK_SMOOTHING=10
KG_JOIN_CLOSURE_ENABLED=true
KG_MAX_JOIN_HOPS=3
# KG-constrained validation (checks #10-#12).
KG_JOIN_CHECK_ENABLED=true
KG_COLUMN_CHECK_ENABLED=true
# Fan-out guard: shadow it first, then enable (see the rollout table in the design doc).
KG_CARDINALITY_CHECK_ENABLED=false
# Bind the Approach B metadata tools to the ReAct agent (only useful with the fixed tiers on).
KG_TOOLS_ENABLED=false
