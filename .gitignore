node_modules/
dist/
build/
.next/
.nuxt/

# ── Python Build Artifacts ────────────────────────────────────────────────────
*.egg-info/
.eggs/

# ── Jupyter Notebooks (outputs only, keep .ipynb sources) ────────────────────
.ipynb_checkpoints/

