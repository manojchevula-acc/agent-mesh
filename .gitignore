__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Secrets & Environment Files ───────────────────────────────────────────────
.env
.env.backup
.env.local
.env.*.local
# Keep .env.example templates — they are safe to commit

