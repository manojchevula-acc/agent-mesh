# ── Virtual Environments ──────────────────────────────────────────────────────
fab-venv/
.venv/
.venv313/
venv/
env/
.claude/
# ── Python Bytecode & Caches ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Local telemetry runtime output (root folder only — NOT agent-mesh/src/observability/,
# the mesh's telemetry integration package, which must stay tracked)
/observability/
# ── Secrets & Environment Files ───────────────────────────────────────────────
.env
.env.backup
.env.local
.env.*.local
# Keep .env.example templates — they are safe to commit

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
dist/
build/
.next/
.nuxt/

# ── Python Build Artifacts ────────────────────────────────────────────────────
*.egg-info/
.eggs/

# ── Jupyter Notebooks (outputs only, keep .ipynb sources) ────────────────────
.ipynb_checkpoints/

# ── Knowledge Base (large/generated data) ────────────────────────────────────
# my_KB/*

# ── IDE & OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db

# ── Logs & Temporary Files ────────────────────────────────────────────────────
*.log
*.tmp
*.swp
*.bak

# Gernas SDK rules live in gernas-sdk/.gitignore

# ── Test / coverage output ────────────────────────────────────────────────────
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── Generated reports and telemetry dumps (regenerated by scripts; not sources) ──
agent-mesh/observability_report.html
agent-mesh/reports/
agent-mesh/audit_regulatory/
