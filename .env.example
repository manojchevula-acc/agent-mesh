# ═══════════════════════════════════════════════════════════════════════════════
# FAB MCP Hub — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# Lines beginning with # are comments. NEVER commit your actual .env to Git.
#
# JWT Authentication flow (recommended):
#   Hub acts as the auth service — it issues RS256 JWTs signed with its RSA key.
#   The agent logs in once (POST /auth/login) and gets a JWT.
#   /discover returns a short-lived per-server JWT (aud = server_id) for each
#   matched server. MCP servers validate via FastMCP JWTVerifier → hub JWKS.
#
# Quick start (dev mode, no keys needed):
#   1. Copy to .env and set MYSQL_* values
#   2. Leave auth vars empty — services run in open-dev mode automatically
#
# Production hardening:
#   1. Set HUB_AGENT_USERNAME and HUB_AGENT_PASSWORD for agent login
#   2. Set HUB_ADMIN_USERNAME and HUB_ADMIN_PASSWORD for admin console
#   3. The hub auto-generates an RSA key pair in hub_service/.keys/ on first start
#   4. Set MCP_SERVER_ID on each MCP server so tokens are audience-validated
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Ollama LLM ──────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b

# ─── Chat Server (chat_service/chat_server.py) ──────────────────────────────
CHAT_HOST=0.0.0.0
CHAT_PORT=8080

# JWT secret shared between Chat Server and Hub Server (HS256 fallback only).
# Not required when using the RS256 JWT flow — the hub's RSA key pair is used.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE-ME-32-byte-random-hex-value

# Override built-in chat users. Format: username:password:role|...
# Roles: admin (all access), agent (standard), readonly (read-only)
# Default (dev only — insecure): admin/admin, analyst/analyst, viewer/viewer
# CHAT_USERS=admin:StrongPass123!:admin|analyst:AnalystPass456!:agent|viewer:ViewerPass789!:agent

# ─── Hub Server (hub_service/hub_server.py) ─────────────────────────────────
HUB_HOST=0.0.0.0
HUB_PORT=8090
HUB_LLM_ENABLED=true
HUB_SERVER_URL=http://localhost:8090

AUTH_ENABLED=true
AUTH_PROVIDER=local

# Admin console credentials
HUB_ADMIN_USERNAME=admin
HUB_ADMIN_PASSWORD=CHANGE-ME-strong-admin-password

# Agent login credentials — used by agent.py POST /auth/login → RS256 JWT
# The hub validates these and issues a signed JWT; no static keys needed.
HUB_AGENT_USERNAME=agent
HUB_AGENT_PASSWORD=CHANGE-ME-strong-agent-password

# Static API key fallback (optional; use only if login credentials are not set)
# Generate: python -c "import secrets; print(secrets.token_hex(64))"
# HUB_API_KEY=CHANGE-ME-64-byte-random-hex-value
# HUB_API_KEY_ROLES=agent

# Azure Entra ID (enterprise, optional)
# AUTH_PROVIDER=azure
# AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── MCP Servers (datalayer-as-service/mcp_server/) ────────────────────────
MCP_AUTH_ENABLED=true

# Expected JWT issuer (must match hub's HUB_JWT_ISSUER, default: fab-mcp-hub)
MCP_JWT_ISSUER=fab-mcp-hub

# Per-server ID — set this when starting each MCP server so JWTVerifier can
# enforce audience validation (tokens are server-specific, cannot be reused).
# Example start commands:
#   MCP_SERVER_ID=fab-customer-server MCP_TRANSPORT=http MCP_PORT=9100 \
#       python -m mcp_server.customer_server
#   MCP_SERVER_ID=fab-pricing-server  MCP_TRANSPORT=http MCP_PORT=9200 \
#       python -m mcp_server.pricing_server
# MCP_SERVER_ID=

# Static fallback token (MCP_API_KEY) — used when JWT login is not configured
# MCP_API_KEY=CHANGE-ME-64-byte-random-hex-value

# MCP tool key — MCP server's own credential for calling external HTTP services.
# Completely separate from the agent JWT; never forwarded to external tools.
# MCP_TOOL_KEY=CHANGE-ME-tool-service-key

# ─── MySQL ───────────────────────────────────────────────────────────────────
# Primary source: datalayer-as-service/.env (loaded by hub_service/db.py)
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=test_user
# MYSQL_PASSWORD=CHANGE-ME-strong-password
# MYSQL_DATABASE=fab_semantic
