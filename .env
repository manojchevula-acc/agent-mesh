# FAB MCP Hub — Local Dev Environment
# NEVER commit this file to Git.
#
# ── Why does every token start with "eyJhbGciOi"? ──────────────────────────
# Every HS256 JWT has three base64url parts: header.payload.signature
# The header {"alg":"HS256","typ":"JWT"} always encodes to:
#   eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9
# The trace hint shows the first 10 chars → always "eyJhbGciOi".
# This is NOT a sign that the same token is being reused — the payload
# (sub, roles, exp) and HMAC signature are unique per token.
#
# ── JWT auth flow ──────────────────────────────────────────────────────────
# 1. Agent       → POST /auth/login (HUB_AGENT_USERNAME/PASSWORD) → RS256 JWT
# 2. Agent       → POST /discover  (hub JWT) → hub routes + returns per-server JWTs
# 3. Agent       → MCP server      (per-server JWT, aud=server_id) → FastMCP JWTVerifier
# 4. Browser     → Chat server     (user JWT, HS256, JWT_SECRET shared secret)
#
# HUB_API_KEY is a static fallback if agent login is not configured.
# The hub's RSA key pair is auto-generated in hub_service/.keys/ on first start.
#
# ── Hub Server ─────────────────────────────────────────────────────────────
HUB_HOST=0.0.0.0
HUB_PORT=8090
HUB_LLM_ENABLED=true
HUB_SERVER_URL=http://localhost:8090

# ── Hub Auth (hub_service/auth.py) ─────────────────────────────────────────
# AUTH_ENABLED=true + HUB_API_KEY or JWT_SECRET set → real auth
# AUTH_ENABLED=true + no keys → open dev mode (all requests granted admin)
# JWT_SECRET is the HS256 signing key shared between Chat and Hub servers
# HUB_API_KEY is the static bearer token (or a JWT) sent by the agent to the hub
# HUB_ADMIN_USERNAME / HUB_ADMIN_PASSWORD — credentials for Hub Admin Console login
# (username/password form at http://localhost:8090/admin)
AUTH_ENABLED=true
AUTH_PROVIDER=local
HUB_ADMIN_USERNAME=admin
HUB_ADMIN_PASSWORD=admin
# Agent login credentials for POST /auth/login → RS256 JWT
HUB_AGENT_USERNAME=admin
HUB_AGENT_PASSWORD=admin
HUB_API_KEY=26805607f0be83760e340e666fad645830488e5a048bb0e51e47ce236f5c6fce8966a000d45a80dd29efd9c7cb2cec512e6599dae68b6695b9080d5805f9c76b
JWT_SECRET=adf84e9159d1426903dd3cfca5367099445e6f0b8067f2ded0db1c169b36ff6b

# ── Chat Server (chat_service/chat_server.py) ───────────────────────────────
# JWT_SECRET above is reused here — chat mints tokens, hub validates them
CHAT_HOST=0.0.0.0
CHAT_PORT=8080
# CHAT_USERS=alice:pass123:admin|bob:pass456:agent   ← optional; overrides hardcoded users

# ── MCP Servers (datalayer-as-service/mcp_server/auth.py) ──────────────────
#
# Authentication layers:
#   Agent → MCP  : RS256 JWT (aud=server_id) issued by hub via /discover
#                  FastMCP JWTVerifier validates against hub's /.well-known/jwks.json
#                  MCP_API_KEY is a static fallback (backward compat only)
#
#   MCP → Tools  : MCP_TOOL_KEY — separate credential for external HTTP tool services
#                  NEVER the agent JWT; agent identity is consumed at MCP boundary
#
#   MCP → MySQL  : MYSQL_USER / MYSQL_PASSWORD (service credentials, not agent token)
#
MCP_AUTH_ENABLED=true
MCP_JWT_ISSUER=fab-mcp-hub
# Static fallback key — used when hub JWT is not available (backward compat).
MCP_API_KEY=e295bcf3df8e78b352c4e4cb7110f222afdd91e5b775b7a798c0310ad7ac1c1e921384f69d75fe7e7074684b998d6e715a908e6debfe6bc6ad5b447ec1d57dfd
# Tool authentication key — MCP server uses this to authenticate with downstream HTTP tool services.
# SEPARATE from MCP_API_KEY / agent JWT.
# MCP_TOOL_KEY=tool-<hex64>

# ── LLM ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b

# ── MySQL (primary config in datalayer-as-service/.env) ────────────────────
MYSQL_USER=test_user
MYSQL_PASSWORD=Welcome@12345
MYSQL_DATABASE=fab_semantic
